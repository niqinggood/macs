# AI 量化交易员只应由 OpenKitty 的 `@量化交易员` 员工流水线启动。
# 不要把本文件加载到 OpenKitty 主进程的通用模型/工具环境，也不要把
# professional agent 注册为主体可直接调用的 tool/skill。
#
# 下面的绝对路径对应当前 E:/openkitty 隔离运行目录布局；若工作区移动，
# 只修改路径前缀。三个项目必须使用各自的 repo 和 venv，不能共用解释器。
# OPENKITTY_AGENT_RUN_DIR 由 OpenKitty 注入，生产环境不要手工设置。
QUANT_TRADER_MAX_BACKEND_BYTES=4194304

# Chinese security-name lookup and completed A-share daily OHLCV enrichment.
# Network destinations are fixed in code to allowlisted Eastmoney/Tencent HTTPS hosts;
# these settings can only disable access or tighten bounded resources.
QUANT_TRADER_CHINA_MARKET_DATA=enabled
QUANT_TRADER_CHINA_MARKET_TIMEOUT_SECONDS=5
QUANT_TRADER_CHINA_MARKET_MAX_BYTES=2097152

# Agent-scoped credentials. Leave every value empty in source control and
# inject only the credentials required by an enabled backend at process start.
# The worker translates an allowlisted QUANT_TRADER_* value to the conventional
# child-process name; host-wide generic credentials are not inherited.
QUANT_TRADER_OPENAI_API_KEY=
QUANT_TRADER_OPENAI_API_BASE=
QUANT_TRADER_DEEPSEEK_API_KEY=
QUANT_TRADER_FINANCIAL_DATASETS_API_KEY=
QUANT_TRADER_FINNHUB_API_KEY=
QUANT_TRADER_HUGGINGFACE_TOKEN=
QUANT_TRADER_MINIMAX_API_KEY=
# TradingAgents uses a distinct conventional key name for the China endpoint.
# It may be populated from the same deployment secret, but never commit it.
QUANT_TRADER_MINIMAX_CN_API_KEY=
QUANT_TRADER_MINIMAX_BASE_URL=
QUANT_TRADER_MINIMAX_MODEL=MiniMax-M3

# Default deployment: discover one isolated process transport per backend at
# <workspace>/.openkitty/runtime/quant-trader. Repositories and venvs must
# already exist; this agent never clones repositories or installs packages at
# request time. Set QUANT_TRADER_RUNTIME_ROOT only when the reviewed runtime is
# intentionally stored outside the workspace. Explicit per-backend transport
# variables below override discovery.
QUANT_TRADER_AUTO_DISCOVERY=true
# QUANT_TRADER_RUNTIME_ROOT=D:/reviewed-runtime/quant-trader

# TradingAgents (isolated repo + venv)
# QUANT_TRADER_TRADINGAGENTS_REPO=D:/reviewed-runtime/quant-trader/TradingAgents
# QUANT_TRADER_TRADINGAGENTS_PYTHON=D:/reviewed-runtime/quant-trader/venvs/tradingagents/Scripts/python.exe
QUANT_TRADER_TRADINGAGENTS_TIMEOUT_SECONDS=900
# Current reviewed test profile: MiniMax China endpoint, one debate/risk round.
QUANT_TRADER_TRADINGAGENTS_LLM_PROVIDER=minimax-cn
QUANT_TRADER_TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M3
QUANT_TRADER_TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M3
QUANT_TRADER_TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
QUANT_TRADER_TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
QUANT_TRADER_TRADINGAGENTS_MAX_RISK_ROUNDS=1
QUANT_TRADER_TRADINGAGENTS_ENV_ALLOWLIST=MINIMAX_CN_API_KEY,TRADINGAGENTS_LLM_PROVIDER,TRADINGAGENTS_DEEP_THINK_LLM,TRADINGAGENTS_QUICK_THINK_LLM,TRADINGAGENTS_OUTPUT_LANGUAGE,TRADINGAGENTS_MAX_DEBATE_ROUNDS,TRADINGAGENTS_MAX_RISK_ROUNDS
# Optional reviewed adapter override:
# QUANT_TRADER_TRADINGAGENTS_ENTRYPOINT=C:/reviewed-adapters/tradingagents_adapter.py
# QUANT_TRADER_TRADINGAGENTS_MODULE=my_tradingagents_adapter

# AI Hedge Fund (isolated repo + venv)
# QUANT_TRADER_AI_HEDGE_FUND_REPO=D:/reviewed-runtime/quant-trader/ai-hedge-fund
# QUANT_TRADER_AI_HEDGE_FUND_PYTHON=D:/reviewed-runtime/quant-trader/venvs/ai-hedge-fund/Scripts/python.exe
QUANT_TRADER_AI_HEDGE_FUND_TIMEOUT_SECONDS=900
QUANT_TRADER_AI_HEDGE_FUND_ENV_ALLOWLIST=OPENAI_API_KEY,OPENAI_API_BASE,FINANCIAL_DATASETS_API_KEY
# Optional reviewed adapter override:
# QUANT_TRADER_AI_HEDGE_FUND_ENTRYPOINT=C:/reviewed-adapters/ai_hedge_fund_adapter.py
# QUANT_TRADER_AI_HEDGE_FUND_MODULE=my_ai_hedge_fund_adapter

# FinGPT (isolated repo + venv). The bundled reviewed callable invokes the
# upstream FinoGrid MiniMax sentiment provider; it is sentiment research, not a
# price forecast. MINIMAX_BASE_URL selects the account region explicitly.
# QUANT_TRADER_FINGPT_REPO=D:/reviewed-runtime/quant-trader/FinGPT
# QUANT_TRADER_FINGPT_PYTHON=D:/reviewed-runtime/quant-trader/venvs/fingpt/Scripts/python.exe
QUANT_TRADER_FINGPT_CALLABLE=fingpt_minimax_callable:analyze
QUANT_TRADER_FINGPT_TIMEOUT_SECONDS=900
QUANT_TRADER_FINGPT_ENV_ALLOWLIST=QUANT_TRADER_FINGPT_CALLABLE,MINIMAX_API_KEY,MINIMAX_BASE_URL,MINIMAX_MODEL

# HTTP is an advanced alternative and is disabled by default. Enable exactly
# one transport for a backend only after deploying and reviewing an endpoint
# that implements openkitty.professional-agent/backend/v1. Never set both its
# *_HTTP_ENDPOINT and *_PYTHON variables.
# QUANT_TRADER_TRADINGAGENTS_HTTP_ENDPOINT=https://quant-internal.example/tradingagents/analyze
# QUANT_TRADER_AI_HEDGE_FUND_HTTP_ENDPOINT=https://quant-internal.example/ai-hedge-fund/analyze
# QUANT_TRADER_FINGPT_HTTP_ENDPOINT=https://quant-internal.example/fingpt/analyze

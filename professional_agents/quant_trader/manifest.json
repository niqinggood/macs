{
  "protocol": "openkitty.professional-agent/v1",
  "id": "quant-trader",
  "version": "0.2.0",
  "command": "python",
  "args": ["-u", "worker.py"],
  "allowed_employees": [
    "quant-trader",
    "investment-research-manager",
    "financial-intelligence-analyst"
  ],
  "capabilities": [
    "analyze",
    "health",
    "trading",
    "research-management",
    "financial-intelligence"
  ],
  "environment": [
    "QUANT_TRADER_MAX_BACKEND_BYTES",
    "QUANT_TRADER_MAX_REQUEST_BYTES",
    "QUANT_TRADER_CHINA_MARKET_DATA",
    "QUANT_TRADER_CHINA_MARKET_TIMEOUT_SECONDS",
    "QUANT_TRADER_CHINA_MARKET_MAX_BYTES",
    "QUANT_TRADER_AUTO_DISCOVERY",
    "QUANT_TRADER_RUNTIME_ROOT",
    "QUANT_TRADER_TRADINGAGENTS_REPO",
    "QUANT_TRADER_TRADINGAGENTS_PYTHON",
    "QUANT_TRADER_TRADINGAGENTS_ENTRYPOINT",
    "QUANT_TRADER_TRADINGAGENTS_MODULE",
    "QUANT_TRADER_TRADINGAGENTS_HTTP_ENDPOINT",
    "QUANT_TRADER_TRADINGAGENTS_TIMEOUT_SECONDS",
    "QUANT_TRADER_TRADINGAGENTS_ENV_ALLOWLIST",
    "QUANT_TRADER_TRADINGAGENTS_LLM_PROVIDER",
    "QUANT_TRADER_TRADINGAGENTS_DEEP_THINK_LLM",
    "QUANT_TRADER_TRADINGAGENTS_QUICK_THINK_LLM",
    "QUANT_TRADER_TRADINGAGENTS_LLM_BACKEND_URL",
    "QUANT_TRADER_TRADINGAGENTS_OUTPUT_LANGUAGE",
    "QUANT_TRADER_TRADINGAGENTS_MAX_DEBATE_ROUNDS",
    "QUANT_TRADER_TRADINGAGENTS_MAX_RISK_ROUNDS",
    "QUANT_TRADER_TRADINGAGENTS_RESULTS_DIR",
    "QUANT_TRADER_TRADINGAGENTS_CACHE_DIR",
    "QUANT_TRADER_TRADINGAGENTS_MEMORY_LOG_PATH",
    "QUANT_TRADER_AI_HEDGE_FUND_REPO",
    "QUANT_TRADER_AI_HEDGE_FUND_PYTHON",
    "QUANT_TRADER_AI_HEDGE_FUND_ENTRYPOINT",
    "QUANT_TRADER_AI_HEDGE_FUND_MODULE",
    "QUANT_TRADER_AI_HEDGE_FUND_HTTP_ENDPOINT",
    "QUANT_TRADER_AI_HEDGE_FUND_TIMEOUT_SECONDS",
    "QUANT_TRADER_AI_HEDGE_FUND_ENV_ALLOWLIST",
    "QUANT_TRADER_FINGPT_REPO",
    "QUANT_TRADER_FINGPT_PYTHON",
    "QUANT_TRADER_FINGPT_ENTRYPOINT",
    "QUANT_TRADER_FINGPT_MODULE",
    "QUANT_TRADER_FINGPT_HTTP_ENDPOINT",
    "QUANT_TRADER_FINGPT_TIMEOUT_SECONDS",
    "QUANT_TRADER_FINGPT_ENV_ALLOWLIST",
    "QUANT_TRADER_FINGPT_CALLABLE",
    "QUANT_TRADER_OPENAI_API_KEY",
    "QUANT_TRADER_OPENAI_API_BASE",
    "QUANT_TRADER_DEEPSEEK_API_KEY",
    "QUANT_TRADER_MINIMAX_API_KEY",
    "QUANT_TRADER_MINIMAX_CN_API_KEY",
    "QUANT_TRADER_MINIMAX_BASE_URL",
    "QUANT_TRADER_MINIMAX_MODEL",
    "QUANT_TRADER_FINANCIAL_DATASETS_API_KEY",
    "QUANT_TRADER_FINNHUB_API_KEY",
    "QUANT_TRADER_HUGGINGFACE_TOKEN"
  ],
  "model_credentials": [
    {
      "binding": "reasoning",
      "environment": {
        "api_key": [
          "QUANT_TRADER_MINIMAX_API_KEY",
          "QUANT_TRADER_MINIMAX_CN_API_KEY",
          "QUANT_TRADER_OPENAI_API_KEY"
        ],
        "base_url": [
          "QUANT_TRADER_MINIMAX_BASE_URL",
          "QUANT_TRADER_OPENAI_API_BASE"
        ],
        "model_name": [
          "QUANT_TRADER_MINIMAX_MODEL"
        ]
      },
      "required": ["api_key", "base_url", "model_name"]
    }
  ],
  "max_output_bytes": 1048576,
  "max_timeout_seconds": 1200
}

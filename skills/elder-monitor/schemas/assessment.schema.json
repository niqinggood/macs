{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/elder-monitor/assessment.schema.json",
  "title": "Elder monitoring risk assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "event_id",
    "severity",
    "alert_required",
    "summary",
    "risk_hypotheses",
    "evidence",
    "uncertainty",
    "recommended_actions",
    "triggered_rules",
    "model_review",
    "policy_version",
    "not_a_diagnosis"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical"]
    },
    "alert_required": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1},
    "risk_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "confidence"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "priority"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "timeout_sec": {"type": "integer", "minimum": 1},
          "note": {"type": "string"}
        }
      }
    },
    "triggered_rules": {"type": "array", "items": {"type": "string"}},
    "model_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "policy_version": {"type": "string", "minLength": 1},
    "not_a_diagnosis": {"const": true}
  }
}


